# Environment Variables for Gradient Tweet MCP App
# Copy this file to .env and fill in your values

# Node environment
NODE_ENV=development

# Apify - Get your API token from https://console.apify.com/settings/integrations
APIFY_API_TOKEN=a
# Cloudinary - Get credentials from https://console.cloudinary.com/settings/c-xxxx/api-keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public URL - Your ngrok URL in development, production URL later
# Example: https://abc123.ngrok-free.app
PUBLIC_URL=
